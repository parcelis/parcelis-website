{
  "name": "falling-sunset-500f",
  "main": "worker.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "preview.parcelis.dev",
      "zone_name": "parcelis.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
