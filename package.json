    "predeploy": "npm run organize:assets"
  },
  "dependencies": {
    "@webstudio-is/sdk": "0.308.0"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  },
  "name": "parcelis-website",
  "engines": {
    "node": ">=22.12.0"
  }
}
